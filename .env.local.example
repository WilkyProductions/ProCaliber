# Copy this file to .env.local and fill in real values.
# .env.local is gitignored and will also need to be added in
# Vercel under Project Settings -> Environment Variables.

# Resend API key: https://resend.com/api-keys
RESEND_API_KEY=

# Inbox that contact form submissions should be sent to
CONTACT_TO_EMAIL=

# Sender address used in the "From" header. Must be on a domain verified
# in Resend (https://resend.com/domains). Leave unset to use Resend's
# shared "onboarding@resend.dev" address for testing before a domain is
# verified.
CONTACT_FROM_EMAIL=
